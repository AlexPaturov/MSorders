{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "FileLogging": {
    "Directory": "logs"
  },
  "AllowedHosts": "*",
  "Databases": {
    "ActiveDatabase": "SqLite",
    "Postgres": {
      "ConnectionString": "",
      "CommandTimeoutSeconds": 30,
      "EnableSensitiveDataLogging": true
    },
    "SqLite": {
      "ConnectionString": "",
      "CommandTimeoutSeconds": 30,
      "EnableSensitiveDataLogging": true
    }
  }
}
